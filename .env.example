# Reference values for local shells only. This project does not load .env files automatically.
# Set these variables in the terminal before starting Core API; replace every placeholder.
PORT=3000
CORS_ORIGIN=http://localhost:5173
INTERNAL_SERVICE_KEY=replace-with-a-long-random-internal-key
AI_ENGINE_URL=http://127.0.0.1:4100
# Must match AI_ENGINE_SHARED_SECRET in apps/ai-engine/.env.example
AI_ENGINE_SHARED_SECRET=replace-with-a-different-long-random-ai-key
AI_ENGINE_TIMEOUT_MS=15000
DEMO_ADMIN_KEY=replace-with-a-random-admin-demo-key
DEMO_MANAGER_KEY=replace-with-a-random-manager-demo-key
DEMO_OPERATOR_KEY=replace-with-a-random-operator-demo-key
DEMO_VIEWER_KEY=replace-with-a-random-viewer-demo-key

# Prisma schema validation only; application persistence is not wired up.
DATABASE_URL=postgresql://user:password@localhost:5432/aegis_supplier_risk?schema=public
