{
  "name": "aegis-supplier-risk",
  "private": true,
  "version": "1.0.0",
  "description": "AEGIS supplier-risk demonstrator: multi-tier disruption impact and recovery recommendations.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:evaluate": "pnpm --filter @aegis/ai-engine test:evaluate",
    "dev:core-api": "pnpm --filter core-api start:dev",
    "dev:ai-engine": "pnpm --filter @aegis/ai-engine dev",
    "start:ai-engine": "pnpm --filter @aegis/ai-engine start",
    "build:core-api": "pnpm --filter core-api build",
    "build:contracts-core": "pnpm --filter @aegis-pay/contracts-core build",
    "measure:latency": "pnpm --filter @aegis/ai-engine measure:latency",
    "check:core-api": "pnpm --filter @aegis/ai-engine check:core-api",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.yml down"
  },
  "packageManager": "pnpm@11.5.2"
}
