{
  "name": "@aegis/ai-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AEGIS supplier-risk AI Engine - read-only disruption analysis and recovery recommendations.",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --tsconfig tsconfig.dev.json src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.dev.json",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest",
    "test:evaluate": "tsx --tsconfig tsconfig.dev.json evaluation/run.ts",
    "measure:latency": "tsx --tsconfig tsconfig.dev.json evaluation/latency.ts",
    "check:core-api": "tsx --tsconfig tsconfig.dev.json scripts/contract-check.ts"
  },
  "dependencies": {
    "@aegis/contracts-ai": "workspace:*",
    "fastify": "^5.0.0",
    "pino": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
