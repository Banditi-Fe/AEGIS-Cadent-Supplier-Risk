# Reference values for local shells only. This application does not load .env files automatically.
# Set these variables in the terminal before starting the AI Engine; replace every placeholder.
AI_ENGINE_SHARED_SECRET=replace-with-the-same-ai-key-as-core-api
CORE_API_BASE_URL=http://127.0.0.1:3000
# Must match INTERNAL_SERVICE_KEY in the Core API shell.
CORE_API_SERVICE_KEY=replace-with-the-core-internal-key
TOOL_TIMEOUT_MS=5000
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
AI_REQUEST_TIMEOUT_MS=8000
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_OUTPUT_TOKENS=900
AI_TOTAL_TIMEOUT_MS=30000
MAX_CONCURRENT_ANALYSES=4
ORG_RATE_LIMIT_PER_MINUTE=30
READY_REQUIRES_CORE_API=false
METRICS_ENABLED=true
